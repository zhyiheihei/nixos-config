+static void lckfb_31inch_gip_sequence(struct st7701 *st7701)
+{
+	/*
+	 * Vendor LCKFB BSP sequence for the D310T9362V1 480x800 panel
+	 * (tspi-rk3566-dsi-v10.dtsi), replayed in place: init_sequence()
+	 * has switched to Command2 BK1 and programmed BK0/BK1 from desc
+	 * (matching the vendor bytes); this re-applies the vendor values
+	 * that the generic code computes differently and adds the vendor
+	 * commands the generic code never sends.
+	 */
+	/* BK1 extras (vendor D1 11, 55 B0) */
+	ST7701_WRITE(st7701, 0xD1, 0x11);
+	ST7701_WRITE(st7701, 0x55, 0xB0);
+
+	/* BK0: line count, porches, inversion, direction, gamma tables */
+	st7701_switch_cmd_bkx(st7701, true, 0);
+	ST7701_WRITE(st7701, 0xC0, 0x63, 0x00);
+	ST7701_WRITE(st7701, 0xC1, 0x09, 0x02);
+	ST7701_WRITE(st7701, 0xC2, 0x37, 0x08);
+	ST7701_WRITE(st7701, 0xC7, 0x00);
+	ST7701_WRITE(st7701, 0xCC, 0x38);
+	st7701->write_command(st7701, ST7701_CMD2_BK0_PVGAMCTRL,
+			      st7701->desc->pv_gamma,
+			      ARRAY_SIZE(st7701->desc->pv_gamma));
+	st7701->write_command(st7701, ST7701_CMD2_BK0_NVGAMCTRL,
+			      st7701->desc->nv_gamma,
+			      ARRAY_SIZE(st7701->desc->nv_gamma));
+
+	/* BK1: gamma / source timing E0h-EFh (vendor block) */
+	st7701_switch_cmd_bkx(st7701, true, 1);
+	ST7701_WRITE(st7701, 0xE0, 0x00, 0x00, 0x02);
+	ST7701_WRITE(st7701, 0xE1, 0x01, 0xA0, 0x03, 0xA0, 0x02, 0xA0,
+		     0x04, 0xA0, 0x00, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE2, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		     0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xE3, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE4, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE5, 0x01, 0x26, 0xA0, 0xA0, 0x03, 0x28,
+		     0xA0, 0xA0, 0x05, 0x2A, 0xA0, 0xA0, 0x07, 0x2C,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xE6, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE7, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE8, 0x02, 0x26, 0xA0, 0xA0, 0x04, 0x28,
+		     0xA0, 0xA0, 0x06, 0x2A, 0xA0, 0xA0, 0x08, 0x2C,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xEB, 0x00, 0x01, 0xE4, 0xE4, 0x44, 0x00,
+		     0x40);
+	ST7701_WRITE(st7701, 0xED, 0xFF, 0xF7, 0x65, 0x4F, 0x0B, 0xA1,
+		     0xCF, 0xFF, 0xFF, 0xFC, 0x1A, 0xB0, 0xF4, 0x56,
+		     0x7F, 0xFF);
+
+	/* Leave Command2 (vendor FF 77 01 00 00 00) and set DCS modes */
+	st7701_switch_cmd_bkx(st7701, false, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_PIXEL_FORMAT, 0x55); /* RGB565 */
+}
+
+static const struct drm_display_mode lckfb_31inch_mode = {
+	.clock		= 27000,
+
+	.hdisplay	= 480,
+	.hsync_start	= 480 + 32,
+	.hsync_end	= 480 + 32 + 4,
+	.htotal		= 480 + 32 + 4 + 32,
+
+	.vdisplay	= 800,
+	.vsync_start	= 800 + 9,
+	.vsync_end	= 800 + 9 + 4,
+	.vtotal		= 800 + 9 + 4 + 3,
+
+	.width_mm	= 41,
+	.height_mm	= 68,
+
+	.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+/*
+ * BK0/BK1 register values below reproduce the vendor BSP bytes exactly:
+ * B0 4D (Vop 4.5V), B1 60 (Vcom 1.3V), B2 07 (Vgh 15V), B5 47 (Vgl -9.51V),
+ * B7 8A / B8 21 (power control), C1 78 / C2 78 (source timing), D0 88
+ * (MIPI, EOT enabled).
+ */
+static const struct st7701_panel_desc lckfb_31inch_desc = {
+	.mode		= &lckfb_31inch_mode,
+	.lanes		= 2,
+	.format		= MIPI_DSI_FMT_RGB565,
+	.panel_sleep_delay = 80,
+
+	.pv_gamma	= { 0x00, 0x11, 0x19, 0x0C, 0x10, 0x06, 0x07, 0x0A,
+			    0x09, 0x22, 0x04, 0x10, 0x0E, 0x28, 0x30, 0x1C },
+	.nv_gamma	= { 0x00, 0x12, 0x19, 0x0D, 0x10, 0x04, 0x06, 0x07,
+			    0x08, 0x23, 0x04, 0x12, 0x11, 0x28, 0x30, 0x1C },
+	.nlinv		= 0x07,
+	.vop_uv		= 4500000,
+	.vcom_uv	= 1300000,
+	.vgh_mv		= 15000,
+	.vgl_mv		= -9510,
+	.avdd_mv	= 6600,
+	.avcl_mv	= -4600,
+	.gamma_op_bias	= OP_BIAS_MIDDLE,
+	.input_op_bias	= OP_BIAS_MIDDLE,
+	.output_op_bias	= OP_BIAS_MIDDLE,
+	.t2d_ns		= 1600,
+	.t3d_ns		= 10400,
+	.eot_en		= true,
+
+	.gip_sequence	= lckfb_31inch_gip_sequence,
+};
+

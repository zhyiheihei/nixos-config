+static void lckfb_31inch_gip_sequence(struct st7701 *st7701)
+{
+	/*
+	 * Vendor sequence for the LCKFB 3.1-inch D310T9362V1 (ST7701S)
+	 * extension board, taken from the Canaan K230 SDK
+	 * (st7701_480x800_init), the only vendor tree driving this
+	 * commercial panel.  Uses ST7701S page 0x13 and RGB666 output.
+	 */
+	/* page 0x13 */
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xEF, 0x08);
+
+	/* BK0: line count, porches, inversion, gamma */
+	st7701_switch_cmd_bkx(st7701, true, 0);
+	ST7701_WRITE(st7701, 0xC0, 0x63, 0x00);
+	ST7701_WRITE(st7701, 0xC1, 0x10, 0x02);
+	ST7701_WRITE(st7701, 0xC2, 0x31, 0x02);
+	ST7701_WRITE(st7701, 0xCC, 0x10);
+	st7701->write_command(st7701, ST7701_CMD2_BK0_PVGAMCTRL,
+			      st7701->desc->pv_gamma,
+			      ARRAY_SIZE(st7701->desc->pv_gamma));
+	st7701->write_command(st7701, ST7701_CMD2_BK0_NVGAMCTRL,
+			      st7701->desc->nv_gamma,
+			      ARRAY_SIZE(st7701->desc->nv_gamma));
+
+	/* BK1: power control + gamma / source timing */
+	st7701_switch_cmd_bkx(st7701, true, 1);
+	ST7701_WRITE(st7701, 0xB0, lckfb_vop);
+	ST7701_WRITE(st7701, 0xB1, lckfb_vcom);
+	ST7701_WRITE(st7701, 0xB2, 0x82);
+	ST7701_WRITE(st7701, 0xB3, 0x80);
+	ST7701_WRITE(st7701, 0xB5, 0x42);
+	ST7701_WRITE(st7701, 0xB7, 0x85);
+	ST7701_WRITE(st7701, 0xB8, 0x20);
+	ST7701_WRITE(st7701, 0xC0, 0x09);
+	ST7701_WRITE(st7701, 0xC1, 0x78);
+	ST7701_WRITE(st7701, 0xC2, 0x78);
+	ST7701_WRITE(st7701, 0xD0, 0x88);
+	ST7701_WRITE(st7701, 0xEE, 0x42);
+	msleep(100);
+	ST7701_WRITE(st7701, 0xE0, 0x00, 0x00, 0x02);
+	ST7701_WRITE(st7701, 0xE1, 0x04, 0xA0, 0x06, 0xA0, 0x05, 0xA0,
+		     0x07, 0xA0, 0x00, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE2, 0x00, 0x00, 0x33, 0x33, 0x01, 0xA0,
+		     0x00, 0x00, 0x01, 0xA0, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xE3, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE4, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE5, 0x0C, 0x30, 0xA0, 0xA0, 0x0E, 0x32,
+		     0xA0, 0xA0, 0x08, 0x2C, 0xA0, 0xA0, 0x0A, 0x2E,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xE6, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE7, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE8, 0x0D, 0x31, 0xA0, 0xA0, 0x0F, 0x33,
+		     0xA0, 0xA0, 0x09, 0x2D, 0xA0, 0xA0, 0x0B, 0x2F,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xEB, 0x00, 0x01, 0xE4, 0xE4, 0x44, 0x88,
+		     0x00);
+	ST7701_WRITE(st7701, 0xED, 0xFF, 0xF5, 0x47, 0x6F, 0x0B, 0xA1,
+		     0xA2, 0xBF, 0xFB, 0x2A, 0x1A, 0xB0, 0xF6, 0x74,
+		     0x5F, 0xFF);
+	ST7701_WRITE(st7701, 0xEF, 0x08, 0x08, 0x08, 0x40, 0x3F, 0x64);
+
+	/* page 0x13 video-mode gate dance + wake + pixel format */
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x0E);
+	st7701_switch_cmd_bkx(st7701, false, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+	msleep(120);
+	st7701_switch_cmd_bkx(st7701, true, 3);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x0C);
+	ST7701_WRITE(st7701, 0xE8, 0x00, 0x00);
+	st7701_switch_cmd_bkx(st7701, true, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_PIXEL_FORMAT, 0x50); /* RGB666 (panel DSI RX is 18-bit only) */
+	ST7701_WRITE(st7701, MIPI_DCS_SET_ADDRESS_MODE, lckfb_madctl);
+}
+

+/*
+ * LCKFB 3.1-inch panel runtime tuning (module parameters, exposed at
+ * /sys/module/panel_sitronix_st7701/parameters/).  lckfb_format only takes
+ * effect at probe time (mipi_dsi_attach): after changing it the panel
+ * driver must be unbound and rebound, a mere fb blank cycle will NOT
+ * re-run it.  All other parameters take effect on the next panel prepare
+ * (e.g. fb blank cycle).  Defaults replicate the vendor sequence.
+ */
+static int lckfb_format = 2;	/* 0=RGB666 loose 1=RGB666 packed 2=RGB888 (vendor) */
+module_param(lckfb_format, int, 0644);
+static int lckfb_madctl = 0x00;	/* MADCTL(36h): vendor 0x00 */
+module_param(lckfb_madctl, int, 0644);
+static int lckfb_colmod = 0x55;	/* COLMOD(3Ah): vendor 0x55 */
+module_param(lckfb_colmod, int, 0644);
+static int lckfb_vop = 0x4D;	/* BK1 B0 source amplitude (vendor) */
+module_param(lckfb_vop, int, 0644);
+static int lckfb_vcom = 0x60;	/* BK1 B1 VCOM (vendor) */
+module_param(lckfb_vcom, int, 0644);
+static int lckfb_cc = 0x38;	/* BK0 CC (vendor; undocumented on ST7701S) */
+module_param(lckfb_cc, int, 0644);
+static int lckfb_e5first = 0x01;	/* E5 gate map first byte (vendor) */
+module_param(lckfb_e5first, int, 0644);
+static int lckfb_e8first = 0x02;	/* E8 gate map first byte (vendor) */
+module_param(lckfb_e8first, int, 0644);
+static int lckfb_cd = -1;	/* COLCTRL(0xCD) value in BK0; -1 = don't send */
+module_param(lckfb_cd, int, 0644);
+static int lckfb_gip = 1;	/* 1 = bank-3 EF 08 prologue + E8 gate dance */
+module_param(lckfb_gip, int, 0644);
+
 #define ST7701_CMD2_BK1_VRHS			0xB0 /* Vop amplitude setting */
 #define ST7701_CMD2_BK1_VCOM			0xB1 /* VCOM amplitude setting */
 #define ST7701_CMD2_BK1_VGHSS			0xB2 /* VGH Voltage setting */

+/*
+ * BK0/BK1 register values below reproduce the official LCKFB taishanpi
+ * vendor bytes exactly (the gip sequence above rewrites the command
+ * registers; the desc fields keep the generic init sequence coherent
+ * with them): B0 4D (Vop 4.5V), B1 60 (Vcom 1.3V), B2 07 (Vgh 15V),
+ * B5 47 (Vgl -9.51V), B7 8A / B8 21 (power control), C1 78 / C2 78
+ * (source timing), D0 88 (MIPI, EOT enabled).  The vendor BSP drives
+ * this panel with MIPI_DSI_FMT_RGB888; mainline ST7701 DSI panels
+ * use RGB888 as well.
+ */
+static const struct st7701_panel_desc lckfb_31inch_desc = {
+	.mode		= &lckfb_31inch_mode,
+	.lanes		= 2,
+	.format		= MIPI_DSI_FMT_RGB888,
+	.panel_sleep_delay = 80,
+
+	.pv_gamma	= { 0x00, 0x11, 0x19, 0x0C, 0x10, 0x06, 0x07, 0x0A,
+			    0x09, 0x22, 0x04, 0x10, 0x0E, 0x28, 0x30, 0x1C },
+	.nv_gamma	= { 0x00, 0x12, 0x19, 0x0D, 0x10, 0x04, 0x06, 0x07,
+			    0x08, 0x23, 0x04, 0x12, 0x11, 0x28, 0x30, 0x1C },
+	.nlinv		= 0x01,
+	.vop_uv		= 4500000,
+	.vcom_uv	= 1300000,
+	.vgh_mv		= 15000,
+	.vgl_mv		= -9510,
+	.avdd_mv	= 6200,
+	.avcl_mv	= -4600,
+	.gamma_op_bias	= OP_BIAS_MIDDLE,
+	.input_op_bias	= OP_BIAS_MIDDLE,
+	.output_op_bias	= OP_BIAS_MIDDLE,
+	.t2d_ns		= 1600,
+	.t3d_ns		= 10400,
+	.eot_en		= true,
+
+	.gip_sequence	= lckfb_31inch_gip_sequence,
+};

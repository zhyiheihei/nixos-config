+/*
+ * BK0/BK1 register values below reproduce the K230 SDK vendor bytes
+ * exactly: B0 5D (Vop 4.7V), B1 62 (Vcom 1.325V), B2 82 (Vgh 12.5V),
+ * B5 42 (Vgl -7.91V), B7 85 / B8 20 (power control), C1 78 / C2 78
+ * (source timing), D0 88 (MIPI, EOT enabled), C0 09 written in gip.
+ */
+static const struct st7701_panel_desc lckfb_31inch_desc = {
+	.mode		= &lckfb_31inch_mode,
+	.lanes		= 2,
+	.format		= MIPI_DSI_FMT_RGB666,
+	.panel_sleep_delay = 80,
+
+	.pv_gamma	= { 0xC0, 0x0C, 0x92, 0x0C, 0x10, 0x05, 0x02, 0x0D,
+			    0x07, 0x21, 0x04, 0x53, 0x11, 0x6A, 0x32, 0x1F },
+	.nv_gamma	= { 0xC0, 0x87, 0xCF, 0x0C, 0x10, 0x06, 0x00, 0x03,
+			    0x08, 0x1D, 0x06, 0x54, 0x12, 0xE6, 0xEC, 0x0F },
+	.nlinv		= 0x01,
+	.vop_uv		= 4700000,
+	.vcom_uv	= 1325000,
+	.vgh_mv		= 12500,
+	.vgl_mv		= -7910,
+	.avdd_mv	= 6600,
+	.avcl_mv	= -4400,
+	.gamma_op_bias	= OP_BIAS_MIDDLE,
+	.input_op_bias	= OP_BIAS_MIN,
+	.output_op_bias	= OP_BIAS_MIN,
+	.t2d_ns		= 1600,
+	.t3d_ns		= 10400,
+	.eot_en		= true,
+
+	.gip_sequence	= lckfb_31inch_gip_sequence,
+};

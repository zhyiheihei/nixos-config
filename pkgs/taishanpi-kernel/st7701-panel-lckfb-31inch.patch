+	.clock		= 27000,
+
+	.hdisplay	= 480,
+	.hsync_start	= 480 + 32,
+	.hsync_end	= 480 + 32 + 4,
+	.htotal		= 480 + 32 + 4 + 32,
+
+	.vdisplay	= 800,
+	.vsync_start	= 800 + 2,
+	.vsync_end	= 800 + 2 + 4,
+	.vtotal		= 800 + 2 + 4 + 16,
+
+	.width_mm	= 41,
+	.height_mm	= 68,
+
+	.flags		= DRM_MODE_FLAG_NHSYNC | DRM_MODE_FLAG_NVSYNC,
+
+	.type		= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,

+static void lckfb_31inch_gip_sequence(struct st7701 *st7701)
+{
+	/*
+	 * Vendor sequence for the LCKFB 3.1-inch D310T9362V1 ("fat little
+	 * cell phone" expansion board screen, ST7701S), replicated byte-for-byte from
+	 * LCKFB's official taishanpi BSP patch (the
+	 * wiki.lckfb.com mobile-phone integrated project chapter,
+	 * "3.1-inch MIPI display patch").  Do NOT substitute sequences
+	 * from other boards driving the same IC family (e.g. the Canaan K230
+	 * SDK st7701_480x800_init): the GIP gate/source tables (E1/E2/E5/
+	 * E8/EB/ED), the undocumented BK0 CC register, gamma and power
+	 * values are specific to this panel's COG wiring.  Driving this
+	 * panel with a foreign sequence swaps the R and G channels.
+	 */
+
+	/*
+	 * Bank-3 (page 0x13) 0xEF 0x08 prologue: present in the K230 SDK and
+	 * every mainline ST7701 vendor sequence that writes GIP E-registers
+	 * (rg_arc, rg28xx, dmt028), absent from the wiki transcription of
+	 * this panel's vendor sequence.  It appears to gate the E0-EE gate/
+	 * source mapping writes in BK1; without it the panel may run with
+	 * its default (channel-rotated) source mapping.  Runtime-tunable.
+	 */
+	if (lckfb_gip) {
+		st7701_switch_cmd_bkx(st7701, true, 3);
+		ST7701_WRITE(st7701, 0xEF, 0x08);
+	}
+
+	/* Command2, BK1: vendor power-on bits (D1/0x55 undocumented) */
+	st7701_switch_cmd_bkx(st7701, true, 1);
+	ST7701_WRITE(st7701, 0xD1, 0x11);
+	ST7701_WRITE(st7701, 0x55, 0xB0);
+
+	/* Command2, BK0: line count, porches, frame control, gamma */
+	st7701_switch_cmd_bkx(st7701, true, 0);
+	ST7701_WRITE(st7701, 0xC0, 0x63, 0x00);
+	ST7701_WRITE(st7701, 0xC1, 0x09, 0x02);
+	ST7701_WRITE(st7701, 0xC2, 0x37, 0x08);
+	ST7701_WRITE(st7701, 0xC7, 0x00);	/* SDIR: normal x-direction */
+	ST7701_WRITE(st7701, 0xCC, lckfb_cc);	/* vendor 0x38 */
+	if (lckfb_cd >= 0)
+		ST7701_WRITE(st7701, 0xCD, lckfb_cd);
+	st7701->write_command(st7701, ST7701_CMD2_BK0_PVGAMCTRL,
+			      st7701->desc->pv_gamma,
+			      ARRAY_SIZE(st7701->desc->pv_gamma));
+	st7701->write_command(st7701, ST7701_CMD2_BK0_NVGAMCTRL,
+			      st7701->desc->nv_gamma,
+			      ARRAY_SIZE(st7701->desc->nv_gamma));
+
+	/* Command2, BK1: power + GIP gate/source tables */
+	st7701_switch_cmd_bkx(st7701, true, 1);
+	ST7701_WRITE(st7701, 0xB0, lckfb_vop);	/* vendor 0x4D */
+	ST7701_WRITE(st7701, 0xB1, lckfb_vcom);	/* vendor 0x60 */
+	ST7701_WRITE(st7701, 0xB2, 0x07);
+	ST7701_WRITE(st7701, 0xB3, 0x80);
+	ST7701_WRITE(st7701, 0xB5, 0x47);
+	ST7701_WRITE(st7701, 0xB7, 0x8A);
+	ST7701_WRITE(st7701, 0xB8, 0x21);
+	ST7701_WRITE(st7701, 0xC1, 0x78);
+	ST7701_WRITE(st7701, 0xC2, 0x78);
+	ST7701_WRITE(st7701, 0xD0, 0x88);	/* MIPI, EOT enabled */
+	msleep(100);
+	ST7701_WRITE(st7701, 0xE0, 0x00, 0x00, 0x02);
+	ST7701_WRITE(st7701, 0xE1, 0x01, 0xA0, 0x03, 0xA0, 0x02, 0xA0,
+		     0x04, 0xA0, 0x00, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE2, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		     0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	ST7701_WRITE(st7701, 0xE3, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE4, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE5, lckfb_e5first, 0x26, 0xA0, 0xA0, 0x03,
+		     0x28, 0xA0, 0xA0, 0x05, 0x2A, 0xA0, 0xA0, 0x07, 0x2C,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xE6, 0x00, 0x00, 0x33, 0x33);
+	ST7701_WRITE(st7701, 0xE7, 0x44, 0x44);
+	ST7701_WRITE(st7701, 0xE8, lckfb_e8first, 0x26, 0xA0, 0xA0, 0x04,
+		     0x28, 0xA0, 0xA0, 0x06, 0x2A, 0xA0, 0xA0, 0x08, 0x2C,
+		     0xA0, 0xA0);
+	ST7701_WRITE(st7701, 0xEB, 0x00, 0x01, 0xE4, 0xE4, 0x44, 0x00,
+		     0x40);
+	ST7701_WRITE(st7701, 0xED, 0xFF, 0xF7, 0x65, 0x4F, 0x0B, 0xA1,
+		     0xCF, 0xFF, 0xFF, 0xFC, 0x1A, 0xB0, 0xF4, 0x56,
+		     0x7F, 0xFF);
+
+	if (lckfb_gip) {
+		/* Video-mode gate dance, as in the K230/dmt028/rg28xx sequences */
+		st7701_switch_cmd_bkx(st7701, true, 3);
+		ST7701_WRITE(st7701, 0xE8, 0x00, 0x0E);
+		st7701_switch_cmd_bkx(st7701, false, 0);
+		ST7701_WRITE(st7701, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+		msleep(120);
+		st7701_switch_cmd_bkx(st7701, true, 3);
+		ST7701_WRITE(st7701, 0xE8, 0x00, 0x0C);
+		msleep(10);
+		ST7701_WRITE(st7701, 0xE8, 0x00, 0x00);
+	}
+
+	/*
+	 * 0x36/0x3A are MIPI DCS commands and only take effect in the
+	 * user command set: they must be sent after leaving Command2
+	 * (inside Command2 BKx the same opcodes are internal regs).
+	 */
+	st7701_switch_cmd_bkx(st7701, false, 0);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_ADDRESS_MODE, lckfb_madctl);
+	ST7701_WRITE(st7701, MIPI_DCS_SET_PIXEL_FORMAT, lckfb_colmod);
+	ST7701_WRITE(st7701, MIPI_DCS_EXIT_SLEEP_MODE, 0x00);
+	msleep(120);
+}

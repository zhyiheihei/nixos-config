 	case MIPI_DSI_FMT_RGB666:
-		s->output_mode = ROCKCHIP_OUT_MODE_P666;
+		/*
+		 * RGB666 non-packed: the DW core transmits 18-bit loose
+		 * packets but samples 24-bit pixels on the DPI bus.  The
+		 * VOP2 P666 output mode drives only 18 bits per pixel,

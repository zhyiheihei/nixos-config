// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * LCKFB Taishan Pi RK3566 - 3.1-inch MIPI DSI panel (ST7701 800x480) overlay.
 *
 * The mainline rk3566-lckfb-tspi.dts only wires HDMI (VP0).  This overlay adds
 * the DSI1 output path for the LCKFB-mipi-3.1inch-screen extension board on
 * VP1 (VP0 stays with HDMI, matching the mainline board DTS).
 *
 * Wiring follows the official vendor BSP dtsi (tspi-rk3566-dsi-v10.dtsi) and
 * the extension board documentation (wiki.lckfb.com 胖妞手机扩展板):
 *   - panel reset on GPIO3_C1 (active low)
 *   - &dsi1 with the st7701 panel as a child node, 2 lanes, lane-rate 480
 *   - backlight: the extension board drives the panel backlight with its own
 *     SY7201ABC circuit (20 mA); brightness is set through the GP7101
 *     I2C-to-PWM chip on I2C1 (addr 0x58).  The board's onboard backlight
 *     circuit (PWM5, 110 mA) must NOT be used for this panel.
 *   - touch: FocalTech FT6236 on I2C1 (addr 0x38), IRQ on GPIO1_A0 (active
 *     low), reset on GPIO1_A1 (active high per LCKFB's driver).
 *
 * The panel and GP7101 drivers are provided by the taishanpi-kernel patches.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

&dsi1 {
	status = "okay";
	rockchip,lane-rate = <480>;
	#address-cells = <1>;
	#size-cells = <0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		dsi1_in: port@0 {
			reg = <0>;
			dsi1_in_vp1: endpoint {
				remote-endpoint = <&vp1_out_dsi1>;
			};
		};

		dsi1_out: port@1 {
			reg = <1>;
			dsi1_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi1>;
			};
		};
	};

	panel: panel@0 {
		compatible = "lckfb,3.1-inch-st7701";
		reg = <0>;
		backlight = <&gp7101_bl>;
		reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&dsi1_rst_gpio>;
		reset-delay-ms = <10>;
		enable-delay-ms = <120>;
		prepare-delay-ms = <20>;
		unprepare-delay-ms = <20>;
		disable-delay-ms = <50>;

		port {
			panel_in_dsi1: endpoint {
				remote-endpoint = <&dsi1_out_panel>;
			};
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	gp7101_bl: backlight@58 {
		compatible = "gp7101-backlight";
		reg = <0x58>;
		max-brightness-levels = <255>;
		default-brightness-level = <100>;
	};

	touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		interrupt-parent = <&gpio1>;
		interrupts = <RK_PA0 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio1 RK_PA1 GPIO_ACTIVE_HIGH>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <800>;
	};
};

&vp1 {
	vp1_out_dsi1: endpoint@ROCKCHIP_VOP2_EP_MIPI1 {
		reg = <ROCKCHIP_VOP2_EP_MIPI1>;
		remote-endpoint = <&dsi1_in_vp1>;
	};
};

&pinctrl {
	lcd {
		dsi1_rst_gpio: dsi1-rst-gpio {
			rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

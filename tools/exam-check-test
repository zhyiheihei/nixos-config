#!/usr/bin/env python3
# tools/exam-check 的回归测试（纯 stdlib unittest，无外部依赖）。
# 在临时 git 仓库上做端到端验证：main=工作树，exam/master=上游，覆盖 A/D/R/skip/
# EXCLUDES/norm_path/改名配对/退出码/幂等。运行： tools/exam-check-test [-v]
import contextlib
import importlib.machinery
import importlib.util
import io
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock

TOOL = Path(__file__).resolve().parent / "exam-check"


def _load():
    loader = importlib.machinery.SourceFileLoader("exam_check_ut", str(TOOL))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


M = _load()


def run(fn, *args):
    """调用会打印/退出的工具函数，返回 (stdout, stderr, exit_code)。"""
    out, err, code = io.StringIO(), io.StringIO(), None
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            fn(*args)
        except SystemExit as e:
            code = e.code
    return out.getvalue(), err.getvalue(), code


def run_main(args=()):
    with mock.patch.object(sys, "argv", ["exam-check", *args]):
        return run(M.main)


class Fixture:
    """只含共享路径子集的临时 git 仓库。"""

    def __init__(self, root):
        self.root = Path(root)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        self.sha = None

    def git(self, *args, check=True):
        return subprocess.run(
            ["git", "-C", str(self.root), *args], check=check, capture_output=True
        )

    def write(self, files):
        for p, data in files.items():
            fp = self.root / p
            if data is None:
                fp.unlink(missing_ok=True)
                continue
            fp.parent.mkdir(parents=True, exist_ok=True)
            fp.write_bytes(data)

    def commit(self, files, msg):
        self.write(files)
        self.git("add", "-A")
        self.git("commit", "-q", "--allow-empty", "-m", msg)
        return self.git("rev-parse", "HEAD").stdout.decode().strip()

    def bind(self, baseline, allow=(), shared=("home",)):
        M.REPO = self.root
        M.SHARED_PATHS = list(shared)
        M.EXCLUDES = ("home/_sources/",)
        M.BASELINE_FILE = self.root / "tools/exam-check-baseline"
        M.BASELINE_FILE.parent.mkdir(parents=True, exist_ok=True)
        M.BASELINE_FILE.write_text(f"baseline: {baseline}\n")
        M.ALLOWLIST_FILE = self.root / "tools/exam-check-allowlist"
        M.ALLOWLIST_FILE.parent.mkdir(parents=True, exist_ok=True)
        M.ALLOWLIST_FILE.write_text("".join(f"{p} # {r}\n" for p, r in allow))
        M.HOSTKEYS_ALLOWLIST_FILE = self.root / "tools/exam-check-hostkeys-allowlist"
        M.HOSTKEYS_ALLOWLIST_FILE.write_text("")

    def scenario(self, base, exam, work, allow=(), shared=("home",)):
        self.sha = self.commit(base, "baseline")
        self.git("checkout", "-q", "-b", "exam/master")
        self.commit(exam, "exam")
        self.git("checkout", "-q", "main")
        self.write(work)
        self.bind(self.sha, allow, shared)
        return self.sha


class Base(unittest.TestCase):
    def setUp(self):
        self._tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self._tmp.cleanup)
        self.fx = Fixture(self._tmp.name)

    def structure(self, subpath=""):
        return M.structure_report(self.fx.sha, M.load_allowlist(), subpath)

    def msgs(self, subpath=""):
        return [r[3] for r in self.structure(subpath)]



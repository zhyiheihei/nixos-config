        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/a.nix": b"a2\n"}, {"home/a.nix": b"a3\n"})

    def test_print_paths(self):
        out, _, _ = run_main(["--print-paths"])
        self.assertEqual(out.strip(), "home")

    def test_structure_subcommand(self):
        out, _, code = run_main(["structure"])
        self.assertIsNone(code)
        self.assertIn("已全部跟进", out)

    def test_diff_subcommand(self):
        out, _, _ = run_main(["diff", "home/a.nix"])
        self.assertIn("+a2", out)

    def test_upstream_subcommand(self):
        out, _, _ = run_main(["upstream"])
        self.assertIn("对比对象", out)


class BaselineMode(Base):
    def test_followed_rename_not_reported_as_upstream_only(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
        )
        out, err, code = run_main()
        self.assertIsNone(code, f"unexpected exit {code}: {err}")
        self.assertNotIn("home/old.nix", out)
        self.assertIn("= 一致 1", out)

    def test_content_drift_detected_across_rename(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
        )
        out, _, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("home/new.nix", out)

    def test_upstream_deleted_file_retained_reported(self):
        """baseline 模式同样要点名「上游删过、本仓仍留」的路径（历史删除，非本批 D）。"""
        fx = self.fx
        sha = fx.commit({"home/a.nix": b"a\n"}, "baseline")
        fx.git("checkout", "-q", "-b", "exam/master")
        fx.commit({"home/gone.nix": b"g\n"}, "add module")
        fx.commit({"home/gone.nix": None}, "treewide: remove unused modules")
        fx.git("checkout", "-q", "main")
        fx.write({"home/a.nix": b"a\n", "home/gone.nix": b"g\n"})
        fx.bind(sha)
        out, err, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("未跟随删除", err)
        self.assertIn("home/gone.nix", out)

    def test_upstream_only_file_missing_is_fatal(self):
        """删掉一个上游仍存在的共享文件必须报错，不能只统计 + 通过。"""
        self.fx.scenario({"home/a.nix": b"a\n", "home/b.nix": b"b\n"}, {"home/a.nix": b"a\n", "home/b.nix": b"b\n"},
                         {"home/a.nix": b"a\n", "home/b.nix": None})
        out, err, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("上游独有", out)
        self.assertIn("home/b.nix", out)
        self.assertIn("上游独有未处理 1 个", err)

    def test_stale_allowlist_entry_is_fatal(self):
        """登记了漂移但漂移已消除（文件与上游一致）时必须报错，禁止留假条目。"""
        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/a.nix": b"a\n"}, {"home/a.nix": b"a\n"},
                         allow=(("home/a.nix", "曾经的漂移"),))
        out, err, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("allowlist 失效条目", out)
        self.assertIn("home/a.nix", out)
        self.assertIn("allowlist 失效条目 1 个", err)

    def test_allowlisted_drift_is_known(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
            allow=[("home/new.nix", "登记差异")],
        )
        out, _, code = run_main()
        self.assertIsNone(code)
        self.assertIn("!known", out)

    def test_strict_ignores_allowlist(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
            allow=[("home/new.nix", "登记差异")],
        )
        _, _, code = run_main(["--strict"])
        self.assertEqual(code, 1)


class UpstreamMode(Base):
    def test_upstream_deleted_file_retained_reported(self):
        """上游删过的模块（换实现/裁未用）若 fork 没跟着删，不能静默算作 fork 独有。"""
        fx = self.fx
        sha = fx.commit({"home/a.nix": b"a\n"}, "baseline")
        fx.git("checkout", "-q", "-b", "exam/master")
        fx.commit({"home/gone.nix": b"g\n"}, "add module")
        fx.commit({"home/gone.nix": None}, "treewide: remove unused modules")
        fx.git("checkout", "-q", "main")
        fx.write({"home/gone.nix": b"g\n"})
        fx.bind(sha)
        out, err, code = run(M.do_upstream, [])
        self.assertEqual(code, 1)
        self.assertIn("上游已删除但本仓仍保留", out)
        self.assertIn("home/gone.nix", out)
        self.assertIn("remove unused modules", out)
        fx.bind(sha, allow=(("home/gone.nix", "fork 主机仍在用"),))
        out, err, code = run(M.do_upstream, [])
        self.assertIsNone(code, f"unexpected exit {code}: {out}{err}")

    def test_rename_not_followed_reported(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"}, {"home/old.nix": None, "home/new.nix": b"x\n"}, {"home/old.nix": b"x\n"}
        )
        out, _, code = run(M.do_upstream, [])
        self.assertEqual(code, 1)
        self.assertIn("改名未跟进", out)
        self.assertIn("home/new.nix -> home/old.nix", out)

    def test_rename_followed_clean(self):

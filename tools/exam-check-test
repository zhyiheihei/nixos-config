class StructureScoping(Base):
    def test_subpath_limits_scope(self):
        self.fx.scenario(
            {"home/a.nix": b"a\n", "helpers/b.nix": b"b\n"},
            {"home/new.nix": b"n\n", "helpers/new2.nix": b"n\n"},
            {},
            shared=("home", "helpers"),
        )
        self.assertEqual(self.msgs("home"), ["未新增 home/new.nix"])
        self.assertEqual(self.msgs("helpers"), ["未新增 helpers/new2.nix"])


class DiffCmd(Base):
    def test_rename_paired_from_either_side(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"}, {"home/old.nix": None, "home/new.nix": b"x\ny\n"}, {"home/old.nix": b"x\n"}
        )
        out, _, _ = run(M.do_diff, ["home/old.nix"])
        self.assertIn("rename from home/old.nix", out)
        self.assertIn("rename to home/new.nix", out)
        out2, _, _ = run(M.do_diff, ["home/new.nix"])
        self.assertIn("rename from home/old.nix", out2)

    def test_plain_modify(self):
        self.fx.scenario({"home/a.nix": b"x\n"}, {"home/a.nix": b"x\ny\n"}, {"home/a.nix": b"x\n"})
        out, _, _ = run(M.do_diff, ["home/a.nix"])
        self.assertIn("+y", out)


class BaselineMode(Base):
    def test_followed_rename_not_reported_as_upstream_only(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
        )
        out, err, code = run_main()
        self.assertIsNone(code, f"unexpected exit {code}: {err}")
        self.assertNotIn("home/old.nix", out)
        self.assertIn("= 一致 1", out)

    def test_content_drift_detected_across_rename(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
        )
        out, _, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("home/new.nix", out)

    def test_allowlisted_drift_is_known(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
            allow=[("home/new.nix", "登记差异")],
        )
        out, _, code = run_main()
        self.assertIsNone(code)
        self.assertIn("!known", out)

    def test_strict_ignores_allowlist(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nY\n"},
            {"home/old.nix": None, "home/new.nix": b"x\nZ\n"},
            allow=[("home/new.nix", "登记差异")],
        )
        _, _, code = run_main(["--strict"])
        self.assertEqual(code, 1)


class UpstreamMode(Base):
    def test_rename_not_followed_reported(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"}, {"home/old.nix": None, "home/new.nix": b"x\n"}, {"home/old.nix": b"x\n"}
        )
        out, _, code = run(M.do_upstream, [])
        self.assertEqual(code, 1)

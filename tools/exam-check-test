#!/usr/bin/env python3
# tools/exam-check 的回归测试（纯 stdlib unittest，无外部依赖）。
# 在临时 git 仓库上做端到端验证：main=工作树，exam/master=上游，覆盖 A/D/R/skip/
# EXCLUDES/norm_path/改名配对/退出码/幂等。运行： tools/exam-check-test [-v]
import contextlib
import importlib.machinery
import importlib.util
import io
import subprocess
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock

TOOL = Path(__file__).resolve().parent / "exam-check"


def _load():
    loader = importlib.machinery.SourceFileLoader("exam_check_ut", str(TOOL))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


M = _load()


def run(fn, *args):
    """调用会打印/退出的工具函数，返回 (stdout, stderr, exit_code)。"""
    out, err, code = io.StringIO(), io.StringIO(), None
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            fn(*args)
        except SystemExit as e:
            code = e.code
    return out.getvalue(), err.getvalue(), code


def run_main(args=()):
    with mock.patch.object(sys, "argv", ["exam-check", *args]):
        return run(M.main)


class Fixture:
    """只含共享路径子集的临时 git 仓库。"""

    def __init__(self, root):
        self.root = Path(root)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        self.sha = None

    def git(self, *args, check=True):
        return subprocess.run(
            ["git", "-C", str(self.root), *args], check=check, capture_output=True
        )

    def write(self, files):
        for p, data in files.items():
            fp = self.root / p
            if data is None:
                fp.unlink(missing_ok=True)
                continue
            fp.parent.mkdir(parents=True, exist_ok=True)
            fp.write_bytes(data)

    def commit(self, files, msg):
        self.write(files)
        self.git("add", "-A")
        self.git("commit", "-q", "-m", msg)
        return self.git("rev-parse", "HEAD").stdout.decode().strip()

    def bind(self, baseline, allow=(), shared=("home",)):
        M.REPO = self.root
        M.SHARED_PATHS = list(shared)
        M.EXCLUDES = ("home/_sources/",)
        M.BASELINE_FILE = self.root / "tools/exam-check-baseline"
        M.BASELINE_FILE.parent.mkdir(parents=True, exist_ok=True)
        M.BASELINE_FILE.write_text(f"baseline: {baseline}\n")
        M.ALLOWLIST_FILE = self.root / "tools/exam-check-allowlist"
        M.ALLOWLIST_FILE.parent.mkdir(parents=True, exist_ok=True)
        M.ALLOWLIST_FILE.write_text("".join(f"{p} # {r}\n" for p, r in allow))

    def scenario(self, base, exam, work, allow=(), shared=("home",)):
        self.sha = self.commit(base, "baseline")
        self.git("checkout", "-q", "-b", "exam/master")
        self.commit(exam, "exam")
        self.git("checkout", "-q", "main")
        self.write(work)
        self.bind(self.sha, allow, shared)
        return self.sha


class Base(unittest.TestCase):
    def setUp(self):
        self._tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self._tmp.cleanup)
        self.fx = Fixture(self._tmp.name)

    def structure(self, subpath=""):
        return M.structure_report(self.fx.sha, M.load_allowlist(), subpath)

    def msgs(self, subpath=""):
        return [r[3] for r in self.structure(subpath)]


class UnitParse(unittest.TestCase):
    def test_all_statuses(self):
        raw = b"R100\x00o\x00n\x00A\x00a\x00D\x00d\x00M\x00m\x00C075\x00s\x00t\x00"
        self.assertEqual(
            M.parse_name_status(raw),
            [("R", "o", "n"), ("A", "a", None), ("D", "d", None), ("M", "m", None), ("C", "s", "t")],
        )

    def test_empty(self):
        self.assertEqual(M.parse_name_status(b""), [])

    def test_binary_normalize_passthrough(self):
        self.assertEqual(M.normalize(b"\x00\x01\x02"), b"\x00\x01\x02")


class UnitNormPath(unittest.TestCase):
    def test_recognized_replacements(self):
        self.assertEqual(
            M.norm_path("nixos/common-apps/nginx/vhosts-lantian.nix"),
            "nixos/common-apps/nginx/vhosts-zhyi.nix",
        )
        self.assertEqual(
            M.norm_path("home/client-apps/ssh/lantian.nix"), "home/client-apps/ssh/zhyi.nix"
        )
        self.assertEqual(
            M.norm_path("home/non-client-apps/per-user/lantian/x"),
            "home/non-client-apps/per-user/zhyi/x",
        )

    def test_noop(self):
        self.assertEqual(
            M.norm_path("home/client-apps/pi/default.nix"), "home/client-apps/pi/default.nix"
        )


class StructureAdded(Base):
    def test_unapplied_then_applied(self):
        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/new.nix": b"n\n"}, {"home/a.nix": b"a\n"})
        self.assertEqual(self.msgs(), ["未新增 home/new.nix"])
        self.fx.write({"home/new.nix": b"n\n"})
        self.assertEqual(self.msgs(), [])

    def test_exit_code_and_message(self):
        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/new.nix": b"n\n"}, {})
        out, _, code = run(M.do_structure, [])
        self.assertEqual(code, 1)
        self.assertIn("未新增 home/new.nix", out)

    def test_skip_exempts(self):
        self.fx.scenario(
            {"home/a.nix": b"a\n"}, {"home/new.nix": b"n\n"}, {}, allow=[("home/new.nix", "skip: 不采纳")]
        )
        self.assertEqual(self.msgs(), [])


class StructureDeleted(Base):
    def test_unapplied_then_applied(self):
        self.fx.scenario({"home/old.nix": b"x\n"}, {"home/old.nix": None}, {})
        self.assertEqual(self.msgs(), ["未删除 home/old.nix"])
        self.fx.write({"home/old.nix": None})
        self.assertEqual(self.msgs(), [])


class StructureRenamed(Base):
    def test_unapplied_then_applied(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"}, {"home/old.nix": None, "home/new.nix": b"x\n"}, {"home/old.nix": b"x\n"}
        )
        self.assertEqual(self.msgs(), ["未改名 home/old.nix -> home/new.nix"])
        self.fx.write({"home/old.nix": None, "home/new.nix": b"x\n"})
        self.assertEqual(self.msgs(), [])

    def test_partial_new_missing(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"}, {"home/old.nix": None, "home/new.nix": b"x\n"}, {"home/old.nix": None}
        )
        self.assertEqual(self.msgs(), ["未改名 home/old.nix -> home/new.nix"])

    def test_low_similarity_degrades_to_add_delete(self):
        content = b"a" * 200 + b"\n"
        self.fx.scenario(
            {"home/x.nix": content},
            {"home/x.nix": None, "home/y.nix": b"b" * 5000 + b"\n"},
            {"home/x.nix": content},
        )
        self.assertEqual(sorted(self.msgs()), sorted(["未删除 home/x.nix", "未新增 home/y.nix"]))



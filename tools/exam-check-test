    def test_rename_followed_clean(self):
        self.fx.scenario(
            {"home/old.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
            {"home/old.nix": None, "home/new.nix": b"x\n"},
        )
        out, err, code = run(M.do_upstream, [])
        self.assertIsNone(code, f"unexpected exit {code}: {out}{err}")


class Stability(Base):
    def test_repeated_structure_runs_identical(self):
        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/a.nix": b"a2\n", "home/new.nix": b"n\n"}, {})
        first = self.msgs()
        self.assertTrue(first)
        for _ in range(3):
            self.assertEqual(self.msgs(), first)

    def test_idempotent_main_output(self):
        self.fx.scenario({"home/a.nix": b"a\n"}, {"home/new.nix": b"n\n"}, {})
        outs = {run_main()[0] for _ in range(3)}
        self.assertEqual(len(outs), 1)



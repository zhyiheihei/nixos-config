class Residual(Base):
    """认可替换只保证两侧归一化等价，不保证 fork 落实；反查必须抓出残留。"""

    BASE = b'x = "gopher\\\\.lantian\\\\.";\n'
    EXAM = b'x = "gopher\\\\.lantian\\\\.";\n# upstream\n'
    FIXED = b'x = "gopher\\\\.zhyi\\\\.";\n'

    def test_residual_reported_and_fails_check(self):
        self.fx.scenario(
            {"home/a.nix": self.BASE},
            {"home/a.nix": self.EXAM},
            {"home/a.nix": self.BASE},
        )
        hits = M.residual_report()
        self.assertEqual([h[0] for h in hits], ["home/a.nix"])
        self.assertEqual(hits[0][2], r"gopher\\.lantian\\.")
        out, _, code = run_main()
        self.assertEqual(code, 1)
        self.assertIn("未落实的认可替换", out)

    def test_substituted_is_clean(self):
        self.fx.scenario(
            {"home/a.nix": self.BASE},
            {"home/a.nix": self.EXAM},
            {"home/a.nix": self.FIXED},
        )
        self.assertEqual(M.residual_report(), [])
        _, _, code = run_main(["--pending-ok"])
        self.assertIsNone(code)

    def test_option_namespace_context_exempt(self):
        text = b'lib.attrByPath [ "lantian" "nginxVhosts" ] { } v\n'
        exam = text + b"# upstream\n"
        self.fx.scenario({"home/a.nix": text}, {"home/a.nix": exam}, {"home/a.nix": text})

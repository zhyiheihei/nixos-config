        out, _, code = run_main(["-v"])
        self.assertEqual(code, 1)
        self.assertIn("====", out)

    def test_log_no_stat(self):
        out, _, code = run(M.do_log, ["--no-stat"])
        self.assertIsNone(code)
        self.assertIn("exam", out)

    def test_log_missing_exam_ref(self):
        self.fx.git("branch", "-D", "exam/master")
        _, err, code = run(M.do_log, [])
        self.assertEqual(code, 2)
        self.assertIn("exam/master 不存在", err)


class Errors(Base):
    def test_missing_baseline_exits_2(self):
        orig_repo, orig_base = M.REPO, M.BASELINE_FILE
        self.addCleanup(
            lambda: (setattr(M, "REPO", orig_repo), setattr(M, "BASELINE_FILE", orig_base))
        )
        M.REPO = self.fx.root
        M.BASELINE_FILE = self.fx.root / "tools/exam-check-baseline"
        _, err, code = run(M.load_baseline)
        self.assertEqual(code, 2)
        self.assertIn("缺少", err)



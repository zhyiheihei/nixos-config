--- a/platformio.ini
+++ b/platformio.ini
@@ -100,6 +100,12 @@ custom_sdkconfig =
   CONFIG_SPIRAM_BOOT_HW_INIT=y
   CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
   CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
+; mbedTLS defaults to internal-RAM-only allocation (CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC).
+; With 8MB PSRAM pooled, internal RAM only has ~9KB contiguous left after WiFi, so
+; esp-tls dies at mbedtls_ssl_setup (-0x7F00 MBEDTLS_ERR_SSL_ALLOC_FAILED).
+; Let mbedTLS allocate from the PSRAM pool instead.
+  CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
+  CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
 ; BLE page-turner (HID host): NimBLE buffers allocate from INTERNAL SRAM
 ; (MEM_ALLOC_MODE_INTERNAL). Trim ACL/MSYS pools to fit a single HID connection
 ; sending <20B notifications, keeping the internal-SRAM footprint modest.

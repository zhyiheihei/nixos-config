REDROID_PATCH_TAG=android-12.0.0_r32

# Orange Pi publishes the board-specific H618 Android 12 source as 18 split
# archives.  The checksum manifest is small enough to pin independently, so a
# source tree is trusted only when the downloader has verified every part and
# written this digest into the extracted source root.
ORANGEPI_ANDROID_SOURCE_MANIFEST_SHA256=3108c7e4a981f09d31bb78c681553f05ca8adf7fb3f0af5d91eadfaf4e9be877
ORANGEPI_ANDROID_SOURCE_GOOGLE_FOLDER_ID=1acn4Oosu1s-39hCK3uRiqj9gG0Jw-tGZ
ORANGEPI_ANDROID_SOURCE_BAIDU_URL=https://pan.baidu.com/s/1BUsudU_XahzB_4eR3s83Ug?pwd=umdt
ORANGEPI_ANDROID_SOURCE_BAIDU_CODE=umdt

# Reference-only locks for the closest public Orange Pi Zero 3 Android 12
# implementation.  These repositories are used to audit board, GPU and CedarX
# deltas; prepare-source.sh never overlays them onto the official BSP.
YAJAT_LONGAN_REFERENCE_COMMIT=47b861f18054c373241666c1ad3cb6ba0f265441
YAJAT_DEVICE_SOFTWINNER_REFERENCE_COMMIT=f4cc19361c00cd4717632f4980191316a0852f3b
YAJAT_HARDWARE_AW_REFERENCE_COMMIT=eb2b7e7c8708284128fc170635d5f9bca2495048
YAJAT_FRAMEWORKS_AV_REFERENCE_COMMIT=4069a322b9154c02184fb7f6c4fed29309ddf257

# Same-SoC fallback/reference.  This is not the Orange Pi Zero 3 board source.
BPI_H618_BSP_COMMIT=316cd80ca43fa17b0385eacd7f6f3652bbd66b2a

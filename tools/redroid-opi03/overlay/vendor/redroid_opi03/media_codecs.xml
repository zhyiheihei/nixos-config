<?xml version="1.0" encoding="utf-8" ?>
<!--
  Android 12 looks up one primary media_codecs.xml and follows explicit
  Include entries from it.  Merely installing media_codecs_allwinner_video.xml
  does not register the Cedar-backed components.
-->
<MediaCodecs>
    <Include href="media_codecs_allwinner_video.xml" />
    <Include href="media_codecs_google_audio.xml" />
    <Include href="media_codecs_google_video.xml" />
</MediaCodecs>

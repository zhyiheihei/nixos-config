def git(*args):
    r = subprocess.run(["git", "-C", str(REPO), *args], capture_output=True)
    if r.returncode != 0:
        die(f"git {' '.join(args)} 失败:\n{r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def die(msg, code=2):
    print(f"exam-check: {msg}", file=sys.stderr)
    sys.exit(code)


def do_host_map(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check host-map",
        description="列出按 exam 服务导入关系核定的主机映射",
    )
    ap.add_argument("exam_host", nargs="?", choices=tuple(SERVICE_IMPORT_HOST_MAPS))
    args = ap.parse_args(argv)
    mappings = (
        {args.exam_host: SERVICE_IMPORT_HOST_MAPS[args.exam_host]}
        if args.exam_host
        else SERVICE_IMPORT_HOST_MAPS
    )
    for upstream, mapping in mappings.items():
        print(f"{upstream} -> {' + '.join(mapping['local_hosts'])}")
        print(f"  {mapping['basis']}")
        print("  多主机映射按服务上下文解析，不做全局 NORMALIZE 替换。")


def load_baseline():
    if not BASELINE_FILE.is_file():
        die(f"缺少 {BASELINE_FILE.relative_to(REPO)}")
    for line in BASELINE_FILE.read_text().splitlines():
        if line.startswith("baseline:"):
            return line.split(":", 1)[1].strip()
    die(f"{BASELINE_FILE.relative_to(REPO)} 中没有 'baseline: <sha>' 行")


def load_allowlist():
    entries = {}
    if not ALLOWLIST_FILE.is_file():
        return entries
    for raw in ALLOWLIST_FILE.read_text().splitlines():
        if "#" in raw:
            path, reason = raw.split("#", 1)
            path = path.strip()
            if path:
                entries[path] = reason.strip()
    return entries


def load_hostkeys_allowlist():
    entries = {}
    if not HOSTKEYS_ALLOWLIST_FILE.is_file():
        return entries
    for raw in HOSTKEYS_ALLOWLIST_FILE.read_text().splitlines():
        if "#" in raw:
            key, reason = raw.split("#", 1)
            key = key.strip()
            if key:
                entries[key] = reason.strip()
    return entries


HOST_KEY_RE = re.compile(r"^  ([A-Za-z][A-Za-z0-9_-]*)\s*=", re.M)


def host_key_usage(rev=None, hosts_root=None):
    """统计 host.nix 顶层选项键的使用次数。

    rev 给定时从该 git 版本读上游 hosts/；否则读工作树 hosts_root。
    """
    usage = {}
    if rev:
        listing = git("ls-tree", "-r", "--name-only", rev, "--", "hosts/").decode().split()
        sources = [
            (path, lambda path=path: git("show", f"{rev}:{path}").decode(errors="surrogateescape"))
            for path in listing
            if path.endswith("/host.nix")
        ]
    else:
        sources = [(str(p), p.read_text) for p in sorted(Path(hosts_root).glob("*/host.nix"))]
    for _, read in sources:
        keys = set(HOST_KEY_RE.findall(read()))
        for key in keys:
            usage[key] = usage.get(key, 0) + 1
    return usage


def host_keys_report(strict=False):
    """上游 host.nix 用过、fork 一次都没用的选项键。

    主机配置不逐字对齐（域名/IP/机名是环境事实），但「上游某选项在某类主机上
    显式设置、fork 从不设置」通常是漏跟（如 firewalled 白名单模型改造）。
    """
    upstream = host_key_usage(rev="exam/master")
    fork = host_key_usage(hosts_root=REPO / "hosts")
    accepted = {} if strict else load_hostkeys_allowlist()
    missing = sorted(k for k, n in upstream.items() if n > 0 and fork.get(k, 0) == 0)
    unacked = [k for k in missing if k not in accepted]
    acked = [k for k in missing if k in accepted]
    stale = [k for k in accepted if k in fork]
    return upstream, fork, unacked, acked, stale, accepted


def print_host_keys(unacked, acked, stale, accepted):
    if unacked:
        print("\n! host.nix 选项键未跟上（上游在多台主机显式设置，fork 从未设置）：")
        for key in unacked:
            print(f"  {key}")
        print("  处理：按语义逐台补上，或在 tools/exam-check-hostkeys-allowlist 登记原因")
    if acked:
        print("\nhost.nix 已登记不跟的选项键:")
        for key in acked:
            print(f"  {key}  # {accepted.get(key, '')}")
    if stale:
        print("\nhostkeys allowlist 失效条目（fork 已使用该键，请删除）:")
        for key in stale:
            print(f"  {key}")


def do_host_keys(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check host-keys",
        description="上游 host.nix 的顶层选项键 vs 本仓（主机配置不逐字对齐，但键集合要跟上）",
    )
    ap.add_argument("--strict", action="store_true", help="忽略 hostkeys allowlist")
    a = ap.parse_args(argv)
    upstream, fork, unacked, acked, stale, accepted = host_keys_report(a.strict)
    print(f"host.nix 选项键：上游 {len(upstream)} 个、本仓 {len(fork)} 个")
    print_host_keys(unacked, acked, stale, accepted)
    if unacked:
        sys.exit(1)
    print("\nexam-check host-keys: 通过")


def normalize(data: bytes):
    if b"\x00" in data:
        return data
    text = data.decode("utf-8", errors="surrogateescape")
    for old, new in NORMALIZE:
        text = text.replace(old, new)
    return text


# 反向还原规则（把选项命名空间改回上游写法）不是待替换的上游标识，反查时跳过。
RESIDUAL_SKIP = {'[ "zhyi" "nginxVhosts" ]'}
# 选项命名空间的合法上下文：整段内出现 "lantian" 属模块选项路径，不是用户名。
RESIDUAL_CONTEXT_EXEMPT = ('[ "lantian" "nginxVhosts" ]',)
# 审计工具自身即替换词表的载体，不参与反查。
RESIDUAL_SELF_FILES = {
    "tools/exam-check",
    "tools/exam-check-allowlist",
    "tools/exam-check-baseline",
    "tools/exam-check-test",
}


def residual_report(subpath=""):
    """反查 fork 里没落实的认可替换（上游标识残留）。

    认可替换只保证「两侧归一化后相等」，并不保证 fork 侧真的换了：上游字符串
    在 fork 里原样保留时两侧归一化后完全相同，会被归为「一致」而隐形。
    2026-11-06 的 gopher/whois 探测期望串（仍是 lantian）就是这么漏了两个月的。
    这里逐条 NORMALIZE 反查 fork 工作树，把残留作为独立审计项出示。
    """
    allowed = set(load_allowlist())
    hits = []
    for path in sorted(worktree_files(subpath)):
        if path in allowed or path in RESIDUAL_SELF_FILES or path.startswith(EXCLUDES):
            continue
        full = REPO / path
        if not full.is_file():
            continue
        data = full.read_bytes()
        if b"\x00" in data:
            continue
        text = data.decode("utf-8", errors="surrogateescape")
        lines = text.splitlines()
        exempt_spans = []
        for ctx in RESIDUAL_CONTEXT_EXEMPT:
            start = 0
            while True:
                idx = text.find(ctx, start)
                if idx < 0:
                    break
                exempt_spans.append((idx, idx + len(ctx)))
                start = idx + len(ctx)
        for old, new in NORMALIZE:
            if old in RESIDUAL_SKIP or old in new:
                continue
            start = 0
            while True:
                idx = text.find(old, start)
                if idx < 0:
                    break
                start = idx + len(old)
                if any(lo <= idx and start <= hi for lo, hi in exempt_spans):
                    continue
                lineno = text.count("\n", 0, idx) + 1
                hits.append((path, lineno, old, new, lines[lineno - 1].strip()[:120]))
    return hits


def print_residual(hits, limit=60):
    print("\n! 未落实的认可替换（fork 侧仍保留上游标识，改成 → 后的值）:")
    for path, lineno, old, new, snippet in hits[:limit]:
        print(f"  {path}:{lineno}  {old!r} → {new!r}")
        print(f"      {snippet}")
    if len(hits) > limit:
        print(f"  …（其余 {len(hits) - limit} 处省略）")


def norm_path(p):
    """路径级认可替换（vhosts-lantian.nix→vhosts-zhyi.nix 等），供结构审计配对。"""
    for old, new in NORMALIZE:
        p = p.replace(old, new)
    return p


def parse_name_status(out):
    toks = [t for t in out.decode("utf-8", errors="surrogateescape").split("\0") if t]
    ops, i = [], 0
    while i < len(toks):
        code = toks[i][0]
        if code in ("R", "C"):
            ops.append((code, toks[i + 1], toks[i + 2]))
            i += 3
        else:
            ops.append((code, toks[i + 1], None))
            i += 2
    return ops


def tree_ops(rev, subpath=""):
    """rev 相对工作树（rev 为 <base>..<tip> 时为两提交间）的 A/D/R 清单。"""
    paths = [subpath] if subpath else SHARED_PATHS
    return parse_name_status(git("diff", "--name-status", "-M", "-z", rev, "--", *paths))


def structure_report(baseline, allow, subpath=""):
    """上游自 baseline 以来的新增/删除/改名是否已跟进（路径过 NORMALIZE + skip 豁免）。"""
    skipped = {p for p, r in allow.items() if r.startswith("skip: ")}
    unapplied = []
    for code, old, new in tree_ops(f"{baseline}..exam/master", subpath):
        if old.startswith(EXCLUDES) or (new and new.startswith(EXCLUDES)):
            continue
        nold = norm_path(old)
        if code == "A":
            if nold in skipped or (REPO / nold).exists():
                continue
            unapplied.append((code, old, new, f"未新增 {nold}"))
        elif code == "D":
            if nold in skipped or not (REPO / nold).exists():
                continue
            unapplied.append((code, old, new, f"未删除 {nold}"))
        elif code == "R":
            nnew = norm_path(new)
            if nnew in skipped or nold in skipped:
                continue
            if (REPO / nnew).exists() and not (REPO / nold).exists():
                continue
            unapplied.append((code, old, new, f"未改名 {nold} -> {nnew}"))
    return unapplied


def commits_touching(baseline, path, limit=8):
    """上游 baseline..exam/master 里改动该文件的提交（新→旧）。"""
    out = git("log", "--format=%h %ad %s", "--date=short", f"{baseline}..exam/master", "--", path)
    lines = [ln for ln in out.decode(errors="replace").splitlines() if ln.strip()]
    return lines[:limit], max(0, len(lines) - limit)


def pending_hunks(baseline, path, limit=12):
    """上游对既有文件塞进来的内容 hunk：返回 [(hunk header, [首行预览...])]。

    上游改既有文件（M）不进基线快照，只靠 allowlist 整文件豁免会漏跟；
    这里把 hunk 头和首行改动出示，条目级变化不再藏在文件级记账后面。
    """
    out = git("diff", "-U0", f"{baseline}..exam/master", "--", path).decode(errors="replace")
    hunks = []
    for line in out.splitlines():
        if line.startswith("@@"):
            hunks.append((line, []))
        elif hunks and not line.startswith(("+++", "---")) and line[:1] in ("+", "-"):
            if len(hunks[-1][1]) < 2:
                hunks[-1][1].append(line.rstrip()[:110])
    return hunks[:limit], max(0, len(hunks) - limit)


def print_pending(baseline, paths, allow):
    """逐文件出示上游条目级变更（commit + hunk），标注 allowlisted。"""
    for p in paths:
        tag = "  [allowlisted]" if p in allow else ""
        print(f"  {p}{tag}")
        commits, more_commits = commits_touching(baseline, p)
        for c in commits:
            print(f"      {c}")
        if more_commits:
            print(f"      …（其余 {more_commits} 个提交省略）")
        hunks, more_hunks = pending_hunks(baseline, p)
        for header, preview in hunks:
            print(f"      {header}")
            for line in preview:
                print(f"        {line}")
        if more_hunks:
            print(f"      …（其余 {more_hunks} 个 hunk 省略，tools/exam-check diff {p}）")


def baseline_files(baseline, subpath):
    out = git("ls-tree", "-r", "--name-only", "-z", baseline, "--", *([subpath] if subpath else SHARED_PATHS))
    return {p for p in out.decode().split("\0") if p and not p.startswith(EXCLUDES)}


def worktree_files(subpath):
    found = set()
    for entry in SHARED_PATHS:
        # 计算该 entry 与 subpath 的相交审计根，避免子目录模式下误扫整个 entry
        if subpath:
            if entry == subpath:
                audit_root = entry
            elif subpath.startswith(entry.rstrip("/") + "/"):
                audit_root = subpath
            elif entry.startswith(subpath.rstrip("/") + "/"):
                audit_root = entry
            else:
                continue
        else:
            audit_root = entry
        full = REPO / audit_root
        if full.is_file():
            found.add(audit_root)
        elif full.is_dir():
            for walk_root, _, files in os.walk(full):
                for f in files:
                    rel = str(Path(walk_root, f).relative_to(REPO))
                    if not rel.startswith(EXCLUDES):
                        found.add(rel)
    return found


def baseline_content(baseline, path):
    return git("show", f"{baseline}:{path}")


def validate_shared_subpath(subpath):
    if not subpath:
        return
    candidate = Path(subpath).as_posix().rstrip("/")
    if not any(
        candidate == root
        or candidate.startswith(root.rstrip("/") + "/")
        or root.startswith(candidate + "/")
        for root in SHARED_PATHS
    ):
        die(
            f"--path {subpath!r} 不在共享审计路径内；hosts/、tools/ 等 fork 自有路径不能报告为对齐通过"
        )
    if not baseline_files(load_baseline(), candidate) and not worktree_files(candidate):
        die(f"--path {subpath!r} 在共享路径内没有匹配文件")


def do_diff(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check diff",
        description="查看上游对某文件自基线以来的完整改动（改名前后路径皆可，rename 自动配对）",
    )
    ap.add_argument("path", help="共享路径内的文件（改名前后皆可）")
    a = ap.parse_args(argv)
    baseline = load_baseline()
    paths = [a.path]
    paired = False
    # 先做改名配对再校验：上游改名后的新路径在 baseline/工作树里都不存在，
    # 先校验会被「共享路径内没有匹配文件」误驳，与「改名前后路径皆可」矛盾。
    for code, old, new in tree_ops(f"{baseline}..exam/master"):
        if code == "R" and (
            a.path in (old, new) or norm_path(a.path) in (norm_path(old), norm_path(new))
        ):
            paths = [old, new]
            paired = True
            break
    if not paired:
        validate_shared_subpath(a.path)
    print(git("diff", f"{baseline}..exam/master", "--", *paths).decode(errors="replace"), end="")


def do_upstream(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check upstream",
        description="工作树 vs exam/master 归一化对比（同步完成度自证；baseline 模式的补充）",
    )
    ap.add_argument("--path", default="", help="只对比某子路径")
    ap.add_argument("-v", "--verbose", action="store_true", help="打印未对齐文件的归一化 diff")
    a = ap.parse_args(argv)
    validate_shared_subpath(a.path)
    allow = load_allowlist()
    up = git("ls-tree", "-r", "--name-only", "-z", "exam/master", "--", *([a.path] if a.path else SHARED_PATHS))
    up_set = {p for p in up.decode().split("\0") if p and not p.startswith(EXCLUDES)}
    work_set = worktree_files(a.path)

    same, subst, known, drift = [], [], [], []
    for p in sorted(up_set & work_set):
        try:
            upb = git("show", f"exam/master:{p}")
        except SystemExit:
            die(f"exam/master 对象缺失（{p}），先 git fetch exam")
        work = (REPO / p).read_bytes()
        if upb == work:
            same.append(p)
        elif normalize(upb) == normalize(work):
            subst.append(p)
        elif p in allow:
            known.append(p)
        else:
            drift.append(p)

    skip_up = {p for p in allow if allow[p].startswith("skip: ")}
    missing = sorted(p for p in up_set - work_set if p not in skip_up)
    fork_only = sorted(work_set - up_set)
    renamed = [
        (old, new)
        for code, old, new in tree_ops("exam/master", a.path)
        if code == "R" and norm_path(old) != norm_path(new)
    ]

    tip = git("rev-parse", "--short", "exam/master").decode().strip()
    print(f"对比对象 exam/master {tip}（基线模式见 tools/exam-check）")
    print(f"统计: = 一致 {len(same)} | ≈ 认可替换 {len(subst)} | fork独有 {len(fork_only)} | − 缺失 {len(missing)} | !known 已登记 {len(known)} | ! 未对齐 {len(drift)}")

    if drift:
        print("\n! 未对齐（checkout/搬 patch，或登记 allowlist）:")
        for p in drift:
            print(f"  {p}")
    if missing:
        print("\n− 缺失（跟进上游文件或登记 'skip: 原因'）:")
        for p in missing:
            print(f"  {p}")
    if known:
        print("\n!known 已登记差异（fork 决策；逐个核对下方归一化 diff 仅含登记项，防整文件豁免吞掉上游新 hunk）:")
        for p in known:
            print(f"  {p}  # {allow.get(p, '')}")
        for p in known:
            base = normalize(git("show", f"exam/master:{p}")).splitlines()
            work = normalize((REPO / p).read_bytes()).splitlines()
            d = list(difflib.unified_diff(base, work, fromfile=f"exam/master:{p}", tofile=f"worktree:{p}", lineterm=""))
            print(f"\n{'=' * 20} {p} (known diff)")
            print("\n".join(d[:120]) or "（无差异）")
            if len(d) > 120:
                print(f"…（其余 {len(d) - 120} 行省略）")
    if renamed:
        print("\n! 上游改名未跟进（上游路径 → 本仓路径）:")
        for old, new in renamed:
            print(f"  {old} -> {new}")
    if a.verbose:
        for p in drift:
            base = normalize(git("show", f"exam/master:{p}")).splitlines()
            work = normalize((REPO / p).read_bytes()).splitlines()
            d = list(difflib.unified_diff(base, work, fromfile=f"exam/master:{p}", tofile=f"worktree:{p}", lineterm=""))
            print(f"\n{'=' * 20} {p}")
            print("\n".join(d[:120]) or "（无差异）")
            if len(d) > 120:
                print(f"…（其余 {len(d) - 120} 行省略）")

    residual = residual_report(a.path)
    if residual:
        print_residual(residual)

    if drift or missing or renamed or residual:
        print(
            f"\nexam-check upstream: 未完全对齐（未对齐={len(drift)} 缺失={len(missing)} "
            f"改名未跟进={len(renamed)} 未落实替换={len(residual)}）",
            file=sys.stderr,
        )
        sys.exit(1)
    print("\nexam-check upstream: 通过")


def do_normalize(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check normalize",
        description="对工作树文件套用认可替换表（同步时 checkout 上游文件后的机械化收尾）",
    )
    ap.add_argument("paths", nargs="+", help="工作树文件路径")
    ap.add_argument("--dry-run", action="store_true", help="只报告命中，不写回")
    a = ap.parse_args(argv)
    touched = 0
    for p in a.paths:
        full = REPO / p
        if not full.is_file():
            die(f"不存在: {p}")
        data = full.read_bytes()
        if b"\x00" in data:
            print(f"跳过（二进制）: {p}")
            continue
        text = data.decode("utf-8", errors="surrogateescape")
        hits = []
        for old, new in NORMALIZE:
            if old in new:
                continue
            n = text.count(old)
            if n:
                text = text.replace(old, new)
                hits.append((old, new, n))
        for old, new, n in hits:
            print(f"{p}: {old!r} → {new!r} ×{n}")
        if hits:
            touched += 1
            if not a.dry_run:
                full.write_bytes(text.encode("utf-8", errors="surrogateescape"))
    verb = "命中" if a.dry_run else "已替换"
    print(f"\nexam-check normalize: {touched} 个文件{verb}认可替换")


def do_structure(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check structure",
        description="上游自基线以来的结构变更（新增/删除/改名）跟进审计",
    )
    ap.add_argument("--path", default="", help="只审计某子路径")
    a = ap.parse_args(argv)
    validate_shared_subpath(a.path)
    baseline = load_baseline()
    allow = load_allowlist()
    unapplied = structure_report(baseline, allow, a.path)
    tip = git("rev-parse", "--short", "exam/master").decode().strip()
    print(f"baseline {baseline[:12]} | exam/master {tip}")
    if not unapplied:
        print("上游结构变更（新增/删除/改名）已全部跟进")
        return
    print("\n! 上游结构变更未跟进（新增/删除/改名）:")
    for code, old, new, msg in unapplied:
        print(f"  [{code}] {msg}")
    print(f"\nexam-check structure: {len(unapplied)} 项未跟进，exit 1", file=sys.stderr)
    sys.exit(1)


def do_log(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check log",
        description="查看 baseline..exam/master 的上游增量（共享路径）",
        epilog="新增量落在 pristine 文件时直接 git checkout exam/master -- <path> 后做认可替换；\n"
               "落在已接管文件（hosts/ 或 allowlist 内）时手动搬 patch；\n"
               "先跑 tools/exam-check structure 过新增/删除/改名（A/D/R），再搬内容；\n"
               "同步完跑 tools/exam-check，绿后 bump tools/exam-check-baseline。",
    )
    ap.add_argument("--fetch", action="store_true", help="先 fetch exam（离线时跳过，用本地已有对象）")
    ap.add_argument("--no-stat", action="store_true", help="只列提交，不显示文件级变更")
    a = ap.parse_args(argv)
    if subprocess.run(["git", "-C", str(REPO), "rev-parse", "--verify", "--quiet", "exam/master"], capture_output=True).returncode != 0:
        die("exam/master 不存在：先 git remote add exam git@github.com:xddxdd/nixos-config && git fetch exam")
    if a.fetch:
        r = subprocess.run(["git", "-C", str(REPO), "fetch", "exam"], capture_output=True)
        if r.returncode != 0:
            lines = r.stderr.decode(errors="replace").strip().splitlines()
            detail = lines[-1] if lines else "未知错误"
            print(f"警告: fetch 失败，使用本地已有对象（{detail}）")
    baseline = load_baseline()
    stat = [] if a.no_stat else ["--stat"]
    out = git("log", "--oneline", *stat, f"{baseline}..exam/master", "--", *SHARED_PATHS)
    text = out.decode(errors="replace").strip()
    if not text:
        print(f"无增量：exam/master 无 baseline {baseline[:12]} 之后共享路径上的新提交")
        return
    print(text)
    print("\n同步提示：pristine 文件 git checkout exam/master -- <path> 后做认可替换；"
          "接管文件（allowlist/hosts/）手动搬 patch；完成后 tools/exam-check，绿后 bump baseline。")


FORK_ONLY_LOCK_INPUTS = {"secrets"}  # 同名但内容必然不同：上游为作者私仓


def lock_report():
    """锁世界审计：共享 inputs 的 locked 值必须与 exam/master 一致。

    2026-10-13 定型：本仓 nixpkgs 带补丁，官方缓存对补丁后的哈希无效，
    能救场的只有作者缓存 + 自家 attic，二者都只覆盖作者锁定的 rev。
    锁脱身（如裸 flake update 拉频道头）= 全舰队退化为源码构建，所以
    除 fork 独有与 secrets 外，任何共享 input 锁值偏离 exam 都算失败。
    """
    import json as _json

    fork = _json.loads((REPO / "flake.lock").read_text()) if (REPO / "flake.lock").is_file() else None
    if fork is None:
        # 审计范围无锁文件（子路径审计、测试夹具）时无锁可比，不算脱离。
        return []
    exam = _json.loads(git("show", "exam/master:flake.lock"))

    def root_inputs(nodes, root):
        r = nodes[root] if isinstance(root, str) else root
        return r["inputs"]

    def resolve(nodes, ref):
        nid = ref if isinstance(ref, str) else list(ref.values())[0]
        while isinstance(nodes.get(nid), str):
            nid = nodes[nid]
        return nid

    froot, eroot = root_inputs(fork["nodes"], fork["root"]), root_inputs(exam["nodes"], exam["root"])
    drift = []
    for name in sorted(set(froot) & set(eroot) - FORK_ONLY_LOCK_INPUTS):
        fn = fork["nodes"][resolve(fork["nodes"], froot[name])]
        en = exam["nodes"][resolve(exam["nodes"], eroot[name])]
        if fn.get("locked") != en.get("locked"):
            f, e = fn.get("locked", {}), en.get("locked", {})
            fk = f.get("rev") or f.get("lastModified", "?")
            ek = e.get("rev") or e.get("lastModified", "?")
            drift.append(f"  {name}: fork={str(fk)[:14]} exam={str(ek)[:14]}")
    return drift


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "host-map":
        do_host_map(argv[1:])
        return
    if argv and argv[0] == "upstream":
        do_upstream(argv[1:])
        return
    if argv and argv[0] == "log":
        do_log(argv[1:])
        return
    if argv and argv[0] == "diff":
        do_diff(argv[1:])
        return
    if argv and argv[0] == "structure":
        do_structure(argv[1:])
        return
    if argv and argv[0] == "host-keys":
        do_host_keys(argv[1:])
        return
    if argv and argv[0] == "normalize":
        do_normalize(argv[1:])
        return
    if argv and argv[0] == "check":
        argv = argv[1:]
    ap = argparse.ArgumentParser(
        prog="tools/exam-check",
        description="共享路径与上游 exam 基线的漂移审计（agent 对齐工作流入口）",
        epilog="常用工作流：\n"
               "  git fetch exam\n"
               "  tools/exam-check log          # 上游改了什么\n"
               "  tools/exam-check host-map     # 查看按服务导入核定的主机映射\n"
               "  tools/exam-check structure    # 上游新增/删除/改名是否已跟进（A/D/R）\n"
               "  tools/exam-check              # 我们漂了多少（含结构审计与上游条目级变更；exit 0=绿，1=有未登记漂移，2=配置错误）\n"
               "  tools/exam-check normalize <path>...  # 验收替换表套用到工作树文件（checkout 上游后收尾）\n"
               "  tools/exam-check -v           # 漂移文件的归一化 diff\n"
               "同步完成后 bump tools/exam-check-baseline 的 baseline。",
    )
    ap.add_argument("-v", "--verbose", action="store_true", help="打印漂移文件的归一化 diff")
    ap.add_argument("--strict", action="store_true", help="忽略 allowlist，未清偿项按未登记漂移对待")
    ap.add_argument(
        "--pending-ok",
        action="store_true",
        help="上游条目级变更（M）不计入失败（同步进行中的临时放行；同步完成必须清零）",
    )
    ap.add_argument("--path", default="", help="只审计某子路径")
    ap.add_argument("--print-paths", action="store_true", help="打印共享路径清单")
    args = ap.parse_args(argv)
    validate_shared_subpath(args.path)

    if args.print_paths:
        print(" ".join(SHARED_PATHS))
        return

    baseline = load_baseline()
    allow = load_allowlist()

    try:
        exam_tip = git("rev-parse", "--short", "exam/master").decode().strip()
    except SystemExit:
        exam_tip = "未 fetch（git fetch exam）"

    base_set = baseline_files(baseline, args.path)
    work_set = worktree_files(args.path)

    # 上游自 baseline 的结构变更：R 需把基线路径映射到工作树期望路径，D 不再比对，
    # A 进入期望集。否则跟随改名后同路径比对全断，旧路径被误报为「上游独有」。
    ops = tree_ops(f"{baseline}..exam/master", args.path)
    rmap = {}
    for code, old, new in ops:
        if code == "R":
            rmap[old] = new
        elif code == "D":
            rmap[old] = None

    same, subst, fork_only, upstream_only = [], [], [], []
    drift, known = [], []
    expected = set()

    for path in sorted(base_set):
        mapped = rmap.get(path, path)
        if mapped is None:
            upstream_only.append(path)
            continue
        ep = norm_path(mapped)
        expected.add(ep)
        if ep not in work_set:
            upstream_only.append(path)
            continue
        try:
            base = baseline_content(baseline, path)
        except SystemExit:
            die(f"基线对象缺失（{baseline}:{path}），先 git fetch exam")
        work = (REPO / ep).read_bytes()
        if base == work:
            same.append(ep)
        elif normalize(base) == normalize(work):
            subst.append(ep)
        else:
            (known if (not args.strict and ep in allow) else drift).append(ep)

    for code, old, new in ops:
        if code == "A":
            expected.add(norm_path(old))

    fork_only = sorted(work_set - expected)

    scoped = args.path
    # 上游独有（base 有而 work 无）也可登记「确认不需要」：带 skip: 前缀的条目
    # 表示 fork 有意不采纳该上游文件，审计时不再提示。
    skipped_upstream = sorted(
        p for p in allow
        if allow[p].startswith("skip: ") and p in base_set and p not in work_set
        and (not scoped or p == scoped or p.startswith(scoped.rstrip("/") + "/"))
    )
    # 上游删除但 fork 决定保留并登记 skip: 的路径同样不算失效条目。
    kept_deleted = {
        old
        for code, old, _ in ops
        if code == "D"
        and allow.get(old, "").startswith("skip: ")
        and (REPO / old).exists()
    }
    upstream_only = [p for p in upstream_only if p not in skipped_upstream]
    stale_allow = [
        p for p in allow
        if p not in drift and p not in known and p not in skipped_upstream
        and p not in kept_deleted
        and (not scoped or p == scoped or p.startswith(scoped.rstrip("/") + "/"))
        and (p in expected or p in base_set)
    ]

    print(f"baseline {baseline[:12]} (tools/exam-check-baseline) | exam/master {exam_tip}")
    content_changed = sorted(
        norm_path(old) for code, old, _ in ops if code == "M" and not old.startswith(EXCLUDES)
    )
    print(f"统计: = 一致 {len(same)} | ≈ 认可替换 {len(subst)} | + fork独有 {len(fork_only)} | − 上游独有 {len(upstream_only)} | !known 已登记 {len(known)} | ! 未登记漂移 {len(drift)} | ! 上游条目未同步 {len(content_changed)}")

    if drift:
        print("\n! 未登记漂移（处理：对齐上游 / 主机级接管，然后登记 allowlist 或修掉）:")
        for p in drift:
            print(f"  {p}")
    if known:
        print("\n!known 已登记漂移（清债清单）:")
        for p in known:
            print(f"  {p}  # {allow.get(p, '')}")
    if upstream_only:
        print("\n− 上游独有（逐个决定：跟进来 / 确认不需要，登记 allowlist 写 'skip: 原因'）:")
        for p in upstream_only:
            print(f"  {p}")
    if skipped_upstream:
        print("\nskip 已确认不需要的上游文件:")
        for p in skipped_upstream:
            print(f"  {p}  # {allow.get(p, '')}")
    if stale_allow:
        print("\nallowlist 失效条目（漂移已消除，请删除）:")
        for p in stale_allow:
            print(f"  {p}")
    # 盲区修复（2026-10-13 obs-noise 漏跟事故）：A/D/R 之外，上游还会往既有文件里
    # 塞内容 hunk（M）。基线快照不包含这些变更，仅靠 allowlist 整文件豁免会漏跟，
    # 必须在每次审计时把 M 条目连 commit/hunk 一起出示（allowlisted 文件同样列）。
    if content_changed:
        print("\n! 上游条目未同步（M，自 baseline；逐 hunk 跟进后 bump baseline）:")
        print_pending(baseline, content_changed, allow)
    lock_drift = [] if args.path else lock_report()
    if lock_drift:
        print(f"\n! 锁世界脱离 exam（共享 inputs locked 值不一致；只许随 exam 同步移动，禁止裸 flake update）:")
        for line in lock_drift:
            print(line)
    struct_unapplied = structure_report(baseline, allow, args.path)
    if struct_unapplied:
        print("\n! 上游结构变更未跟进（新增/删除/改名，逐个 checkout/mv 或登记 skip）:")
        for code, old, new, msg in struct_unapplied:
            print(f"  [{code}] {msg}")
    residual = residual_report(args.path)
    if residual:
        print_residual(residual)
    host_unacked, host_acked, host_stale = [], [], []
    if not args.path:
        _, _, host_unacked, host_acked, host_stale, host_accepted = host_keys_report(args.strict)
        print_host_keys(host_unacked, host_acked, host_stale, host_accepted)
    if args.verbose:
        for p in drift + known:
            base = normalize(baseline_content(baseline, p)).splitlines()
            work = normalize((REPO / p).read_bytes()).splitlines()
            diff = list(difflib.unified_diff(base, work, fromfile=f"baseline:{p}", tofile=f"worktree:{p}", lineterm=""))
            print(f"\n{'=' * 20} {p}")
            print("\n".join(diff[:120]) or "（无差异）")
            if len(diff) > 120:
                print(f"…（其余 {len(diff) - 120} 行省略）")

    pending = [] if args.pending_ok else content_changed
    if drift or struct_unapplied or lock_drift or residual or pending or host_unacked or host_stale:
        print(
            f"\nexam-check: 未登记漂移 {len(drift)} 个、上游结构变更未跟进 {len(struct_unapplied)} 项、"
            f"上游条目未同步 {len(pending)} 个、锁世界脱离 {len(lock_drift)} 项、未落实替换 {len(residual)} 处、"
            f"host 选项键未跟上 {len(host_unacked)} 个、hostkeys allowlist 失效 {len(host_stale)} 个，exit 1",
            file=sys.stderr,
        )
        sys.exit(1)
    print("\nexam-check: 通过")


if __name__ == "__main__":
    main()

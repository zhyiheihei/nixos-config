def git(*args):
    r = subprocess.run(["git", "-C", str(REPO), *args], capture_output=True)
    if r.returncode != 0:
        die(f"git {' '.join(args)} 失败:\n{r.stderr.decode(errors='replace').strip()}")
    return r.stdout


def die(msg, code=2):
    print(f"exam-check: {msg}", file=sys.stderr)
    sys.exit(code)


def load_baseline():
    if not BASELINE_FILE.is_file():
        die(f"缺少 {BASELINE_FILE.relative_to(REPO)}")
    for line in BASELINE_FILE.read_text().splitlines():
        if line.startswith("baseline:"):
            return line.split(":", 1)[1].strip()
    die(f"{BASELINE_FILE.relative_to(REPO)} 中没有 'baseline: <sha>' 行")


def load_allowlist():
    entries = {}
    if not ALLOWLIST_FILE.is_file():
        return entries
    for raw in ALLOWLIST_FILE.read_text().splitlines():
        if "#" in raw:
            path, reason = raw.split("#", 1)
            path = path.strip()
            if path:
                entries[path] = reason.strip()
    return entries


def normalize(data: bytes):
    if b"\x00" in data:
        return data
    text = data.decode("utf-8", errors="surrogateescape")
    for old, new in NORMALIZE:
        text = text.replace(old, new)
    return text


def baseline_files(baseline, subpath):
    out = git("ls-tree", "-r", "--name-only", "-z", baseline, "--", *([subpath] if subpath else SHARED_PATHS))
    return {p for p in out.decode().split("\0") if p and not p.startswith(EXCLUDES)}


def worktree_files(subpath):
    found = set()
    for entry in SHARED_PATHS:
        # 计算该 entry 与 subpath 的相交审计根，避免子目录模式下误扫整个 entry
        if subpath:
            if entry == subpath:
                audit_root = entry
            elif subpath.startswith(entry.rstrip("/") + "/"):
                audit_root = subpath
            elif entry.startswith(subpath.rstrip("/") + "/"):
                audit_root = entry
            else:
                continue
        else:
            audit_root = entry
        full = REPO / audit_root
        if full.is_file():
            found.add(audit_root)
        elif full.is_dir():
            for walk_root, _, files in os.walk(full):
                for f in files:
                    rel = str(Path(walk_root, f).relative_to(REPO))
                    if not rel.startswith(EXCLUDES):
                        found.add(rel)
    return found


def baseline_content(baseline, path):
    return git("show", f"{baseline}:{path}")


def do_log(argv):
    ap = argparse.ArgumentParser(
        prog="tools/exam-check log",
        description="查看 baseline..exam/master 的上游增量（共享路径）",
        epilog="新增量落在 pristine 文件时直接 git checkout exam/master -- <path> 后做认可替换；\n"
               "落在已接管文件（hosts/ 或 allowlist 内）时手动搬 patch；\n"
               "同步完跑 tools/exam-check，绿后 bump docs/agent/upstream-baseline.md。",
    )
    ap.add_argument("--fetch", action="store_true", help="先 fetch exam（离线时跳过，用本地已有对象）")
    ap.add_argument("--no-stat", action="store_true", help="只列提交，不显示文件级变更")
    a = ap.parse_args(argv)
    if subprocess.run(["git", "-C", str(REPO), "rev-parse", "--verify", "--quiet", "exam/master"], capture_output=True).returncode != 0:
        die("exam/master 不存在：先 git remote add exam git@github.com:xddxdd/nixos-config && git fetch exam")
    if a.fetch:
        r = subprocess.run(["git", "-C", str(REPO), "fetch", "exam"], capture_output=True)
        if r.returncode != 0:
            lines = r.stderr.decode(errors="replace").strip().splitlines()
            detail = lines[-1] if lines else "未知错误"
            print(f"警告: fetch 失败，使用本地已有对象（{detail}）")
    baseline = load_baseline()
    stat = [] if a.no_stat else ["--stat"]
    out = git("log", "--oneline", *stat, f"{baseline}..exam/master", "--", *SHARED_PATHS)
    text = out.decode(errors="replace").strip()
    if not text:
        print(f"无增量：exam/master 无 baseline {baseline[:12]} 之后共享路径上的新提交")
        return
    print(text)
    print("\n同步提示：pristine 文件 git checkout exam/master -- <path> 后做认可替换；"
          "接管文件（allowlist/hosts/）手动搬 patch；完成后 tools/exam-check，绿后 bump baseline。")


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "log":
        do_log(argv[1:])
        return
    if argv and argv[0] == "check":
        argv = argv[1:]
    ap = argparse.ArgumentParser(
        prog="tools/exam-check",
        description="共享路径与上游 exam 基线的漂移审计（agent 对齐工作流入口）",
        epilog="常用工作流：\n"
               "  git fetch exam\n"
               "  tools/exam-check log          # 上游改了什么\n"
               "  tools/exam-check              # 我们漂了多少（exit 0=绿，1=有未登记漂移，2=配置错误）\n"
               "  tools/exam-check -v           # 漂移文件的归一化 diff\n"
               "同步完成后 bump docs/agent/upstream-baseline.md 的 baseline。",
    )
    ap.add_argument("-v", "--verbose", action="store_true", help="打印漂移文件的归一化 diff")
    ap.add_argument("--strict", action="store_true", help="忽略 allowlist，未清偿项按未登记漂移对待")
    ap.add_argument("--path", default="", help="只审计某子路径")
    ap.add_argument("--print-paths", action="store_true", help="打印共享路径清单")
    args = ap.parse_args(argv)

    if args.print_paths:
        print(" ".join(SHARED_PATHS))
        return

    baseline = load_baseline()
    allow = load_allowlist()

    try:
        exam_tip = git("rev-parse", "--short", "exam/master").decode().strip()
    except SystemExit:
        exam_tip = "未 fetch（git fetch exam）"

    base_set = baseline_files(baseline, args.path)
    work_set = worktree_files(args.path)

    same, subst, fork_only, upstream_only = [], [], [], []
    drift, known = [], []

    for path in sorted(base_set & work_set):
        try:
            base = baseline_content(baseline, path)
        except SystemExit:
            die(f"基线对象缺失（{baseline}:{path}），先 git fetch exam")
        work = (REPO / path).read_bytes()
        if base == work:
            same.append(path)
        elif normalize(base) == normalize(work):
            subst.append(path)
        else:
            (known if (not args.strict and path in allow) else drift).append(path)

    fork_only = sorted(work_set - base_set)
    upstream_only = sorted(base_set - work_set)

    scoped = args.path
    stale_allow = [
        p for p in allow
        if p not in drift and p not in known
        and (not scoped or p == scoped or p.startswith(scoped.rstrip("/") + "/"))
    ]

    print(f"baseline {baseline[:12]} (docs/agent/upstream-baseline.md) | exam/master {exam_tip}")
    print(f"统计: = 一致 {len(same)} | ≈ 认可替换 {len(subst)} | + fork独有 {len(fork_only)} | − 上游独有 {len(upstream_only)} | !known 已登记 {len(known)} | ! 未登记漂移 {len(drift)}")

    if drift:
        print("\n! 未登记漂移（处理：对齐上游 / 主机级接管，然后登记 allowlist 或修掉）:")
        for p in drift:
            print(f"  {p}")
    if known:
        print("\n!known 已登记漂移（清债清单）:")
        for p in known:
            print(f"  {p}  # {allow.get(p, '')}")
    if upstream_only:
        print("\n− 上游独有（逐个决定：跟进来 / 确认不需要）:")
        for p in upstream_only:
            print(f"  {p}")
    if stale_allow:
        print("\nallowlist 失效条目（漂移已消除，请删除）:")
        for p in stale_allow:
            print(f"  {p}")
    if args.verbose:
        for p in drift + known:
            base = normalize(baseline_content(baseline, p)).decode("utf-8", errors="surrogateescape").splitlines()
            work = normalize((REPO / p).read_bytes()).decode("utf-8", errors="surrogateescape").splitlines()
            diff = list(difflib.unified_diff(base, work, fromfile=f"baseline:{p}", tofile=f"worktree:{p}", lineterm=""))
            print(f"\n{'=' * 20} {p}")
            print("\n".join(diff[:120]) or "（无差异）")
            if len(diff) > 120:
                print(f"…（其余 {len(diff) - 120} 行省略）")

    if drift:
        print(f"\nexam-check: 存在 {len(drift)} 个未登记漂移，exit 1", file=sys.stderr)
        sys.exit(1)
    print("\nexam-check: 通过")


if __name__ == "__main__":
    main()

+
+static const struct hx8394_panel_desc atk_md0550m_desc = {
+	.mode = &atk_md0550m_mode,
+	.lanes = 4,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST,
+	.format = MIPI_DSI_FMT_RGB888,
+	.init_sequence = atk_md0550m_init_sequence,
+};

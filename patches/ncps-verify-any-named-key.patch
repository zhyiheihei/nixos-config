+
+// verifyNarInfoSignatures mirrors nix's own trust semantics: a narinfo is
+// trusted when any signature whose key name matches a configured public key
+// verifies against that key. Unlike signature.VerifyFirst, configured keys
+// sharing the same name (e.g. two independent caches that both sign as
+// "lantian") do not shadow each other through list ordering.
+func verifyNarInfoSignatures(
+	fingerprint string,
+	signatures []signature.Signature,
+	publicKeys []signature.PublicKey,
+) bool {
+	for _, sig := range signatures {
+		for _, pubKey := range publicKeys {
+			if pubKey.Name == sig.Name && pubKey.Verify(fingerprint, sig) {
+				return true
+			}
+		}
+	}
+
+	return false
+}
